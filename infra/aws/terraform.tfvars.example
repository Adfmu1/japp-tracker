aws_region        = "REPLACE_WITH_AWS_REGION"
github_repository = "REPLACE_WITH_OWNER/REPOSITORY"
deployment_instance_arn = "arn:aws:ec2:REPLACE_WITH_REGION:REPLACE_WITH_ACCOUNT:instance/i-REPLACE_WITH_INSTANCE_ID"

# Set this only when the EC2 host already has an instance role. Leave null to
# create the narrowly scoped role and instance profile in this module.
ec2_instance_role_name = null

# Populate with the ARNs output after the first apply, then apply again so the
# EC2 policy can read only these two secret containers.
secret_arns = []
